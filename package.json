{
  "name": "plod",
  "version": "0.1.0",
  "description": "A performance-first TypeScript plotting engine with Canvas, WebGL, streaming, and level-of-detail rendering.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jiangjonathan/plod.git"
  },
  "bugs": {
    "url": "https://github.com/jiangjonathan/plod/issues"
  },
  "homepage": "https://github.com/jiangjonathan/plod#readme",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:settings": "node scripts/check-settings-contract.js",
    "test": "npm run check:settings && npm run typecheck",
    "prepublishOnly": "npm run test && npm run build"
  },
  "keywords": [
    "charts",
    "plotting",
    "canvas",
    "webgl",
    "streaming",
    "large-data",
    "level-of-detail",
    "visualization",
    "typescript"
  ],
  "devDependencies": {
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18"
  }
}
